# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oath_classes"

# Server
PORT=5000

# Comma-separated list of origins allowed to call this API
# (public frontend on 5173, admin panel on 5174 in local dev)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# JWT signing secret — change this in production
JWT_SECRET="change-this-to-a-long-random-string"

# Seed admin/teacher login (used by `npm run seed`)
SEED_ADMIN_EMAIL="admin@oathclasses.in"
SEED_ADMIN_PASSWORD="admin123"
SEED_TEACHER_EMAIL="teacher@oathclasses.in"
SEED_TEACHER_PASSWORD="teacher123"
